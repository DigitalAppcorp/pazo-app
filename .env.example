# Public Supabase browser configuration. These values are not secrets; RLS remains the security boundary.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Local development only while Places/Map demand validation is active.
# Public browser token only. Do not place a Mapbox secret token here.
# Production builds do not mount Mapbox during this experiment.
VITE_MAPBOX_ACCESS_TOKEN=pk.replace_with_your_public_mapbox_token


# Optional frontend observability. Public PostHog project token; never use a personal API key here.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Localhost stays offline by default even when a project token exists.
# Set true only for an explicit observability verification.
VITE_ENABLE_LOCAL_POSTHOG=false

# Optional release identifier for correlating frontend errors with a deployment.
VITE_APP_RELEASE=
