{
  "name": "pazo-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:hardening": "node scripts/hardening-check.mjs",
    "test:architecture": "node scripts/architecture-check.mjs",
    "test:privacy": "node scripts/privacy-check.mjs",
    "test:governance": "npm run test:hardening && npm run test:architecture && npm run test:privacy && npm run test:ops && npm run test:mvp",
    "test:mvp": "node --experimental-strip-types --test src/features/feed/selectFeedPage.test.mjs src/features/feed/advanceFeedCursors.test.mjs src/features/auth/signupFlow.test.mjs src/features/auth/recoveryFlow.test.mjs src/features/account/deletionFlow.test.mjs src/features/account/deletionCoordinator.test.mjs scripts/f14-a3-draft.test.mjs",
    "backup:storage": "node scripts/backup-storage.mjs",
    "test:ops": "node --check scripts/backup-storage.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
